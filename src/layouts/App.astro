---
import Base from './Base.astro';
import LogTabButton from '@/components/LogTabButton';
import { GROUPS } from '@/lib/appNav';

interface Props {
  title?: string;
  // Read-only public showcase: swaps the nav to the /showcase/* surfaces (which
  // mount no write affordances) and shows a "sign in" CTA instead of app tools.
  showcase?: boolean;
}

const { title = 'Verocity', showcase = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const home = showcase ? '/showcase' : '/app';

// The drawer is a map of the app, not a list of routes. Four themed groups,
// each under a caps eyebrow that goes ink while you are inside it — so the
// panel says both where you are and what neighbourhood it belongs to. A flat
// list of nine gave every destination the same volume and buried Settings
// under a lone hairline.
//
// /app/shares lives in "You": it is a real page that was otherwise reachable
// only through a text link inside Settings' Data section.
// /app/activity does NOT belong here — it is an action (log a non-lifting
// activity), already offered by AddSessionMenu from the ribbon's centre slot
// and from Home, and this panel lists places.
type NavGroup = {
  label: string;
  items: { href: string; label: string; svgGlyph?: boolean }[];
};
const groups: NavGroup[] = showcase
  ? [
      {
        label: 'Today',
        items: [
          { href: '/showcase', label: 'Home' },
          { href: '/showcase/calendar', label: 'Calendar' },
        ],
      },
      {
        label: 'Training',
        items: [
          { href: '/showcase/plan', label: 'Plan' },
          { href: '/showcase/library', label: 'Library' },
        ],
      },
      { label: 'Progress', items: [{ href: '/showcase/stats', label: 'Stats' }] },
    ]
  : [
      {
        label: 'Today',
        items: [{ href: '/app', label: 'Home' }],
      },
      {
        label: GROUPS.training.label,
        items: GROUPS.training.tabs.map(({ href, label }) => ({ href, label })),
      },
      {
        label: GROUPS.progress.label,
        items: GROUPS.progress.tabs.map(({ href, label }) => ({ href, label })),
      },
      // One row, no sub-items: You is a single collapsible page
      // (Settings + Share links + Goals), not a neighbourhood of its own.
      { label: 'You', items: [{ href: '/app/you', label: 'You', svgGlyph: true }] },
    ];
const isActive = (href: string) => (href === home ? path === home : path.startsWith(href));
const groupActive = (g: NavGroup) => g.items.some((i) => isActive(i.href));

// The Logger owns the bottom of the screen — it has its own Finish bar, and
// stacking a tab bar under it would put two fixed bars in the thumb zone. It
// is a focused flow you leave deliberately (Finish / Discard), so the tabs sit
// this one out.
const immersive = path === '/app/log';

// The five destinations that earn a permanent thumb-reachable slot, plus the
// centre action. Training and Progress are whole neighbourhoods (see
// src/lib/appNav.ts + GroupPager.tsx) rather than single pages, so tapping one
// opens whichever sub-page you last viewed there. Settings/Shares and detail
// pages stay one tap away behind the drawer, opened from the header now
// instead of a bottom "More" slot. Showcase has no write surface and no
// Sessions/Body/Coach sub-pages, so its centre slot is Plan rather than Log
// and its two trailing tabs stay single pages.
type RibbonIcon = 'home' | 'training' | 'progress' | 'log';
type Tab = {
  href: string;
  label: string;
  glyph: string;
  // When true, render the person-silhouette SVG instead of the text glyph.
  svgGlyph?: boolean;
  // Ribbon icon key — resolves to an inline SVG below. All four ribbon icons
  // share a viewBox, stroke width and use `currentColor` so they read as one
  // set and adapt to fg/muted/paper across theme + active/primary states.
  icon?: RibbonIcon;
  // Inverted chip treatment for the centre slot.
  primary?: boolean;
  // Set when the slot opens a sheet instead of navigating.
  action?: 'log';
  // Set when the tab represents a whole nav group rather than one page — its
  // href is rewritten client-side to the last-viewed sub-page (see the script
  // below) and it is active for any of the group's member routes.
  group?: 'training' | 'progress';
};
const tabs: Tab[] = showcase
  ? [
      { href: '/showcase', label: 'Home', glyph: '', icon: 'home' },
      { href: '/showcase/calendar', label: 'Calendar', glyph: '▤' },
      { href: '/showcase/plan', label: 'Plan', glyph: '◈', primary: true },
      { href: '/showcase/stats', label: 'Stats', glyph: '', icon: 'progress' },
    ]
  : [
      { href: '/app', label: 'Home', glyph: '', icon: 'home' },
      { href: GROUPS.training.base, label: GROUPS.training.label, glyph: '', icon: 'training', group: 'training' },
      // Not a destination: opens the "what are you logging?" sheet.
      { href: '/app/log', label: 'Log', glyph: '', primary: true, action: 'log', icon: 'log' },
      { href: GROUPS.progress.base, label: GROUPS.progress.label, glyph: '', icon: 'progress', group: 'progress' },
      // Calendar retired as a standalone destination — it lives on Home now,
      // above Recent sessions. The trailing slot goes to You (settings, share
      // links, goals) instead.
      { href: '/app/you', label: 'You', glyph: '☺', svgGlyph: true },
    ];

// A group tab is active for any of its member routes, not just its (possibly
// stale) href.
const tabActive = (t: Tab) =>
  t.group ? GROUPS[t.group].tabs.some((gt) => path.startsWith(gt.href)) : isActive(t.href);
---

<Base title={title} shell>
  <a href="#main" class="skip-link">Skip to content</a>
  {/* The chrome is one viewport-sized column that does NOT scroll — `.app-shell`
      in global.css takes the scrolling away from the document, and the div
      below takes it back. The tab bar is then the last flex child of a box
      whose bottom edge IS the screen's bottom edge, so it is not positioned
      against anything that can lag. See the bar at the foot of this file.
      Both fixed overlays (#nav-backdrop, #nav-menu) are out of flow, so they
      are not flex items. */}
  <div class="flex h-full flex-col">
  {/* The scroller. `min-h-0` because a flex item's default `min-height: auto`
      would let it grow to its content instead of scrolling. The inner
      `min-h-full` column keeps `main` filling the scrollport on a short page,
      which is what stops the Logger's Finish bar floating mid-screen there.
      `overflow-x-hidden` is not decoration: `overflow-y: auto` alone computes
      the other axis to `auto` too, so any horizontal overflow turns the app
      chrome into something you pan sideways. Clipping is the better failure —
      `hidden` (not `clip`) so `scrollWidth` still reports the overflow and
      `npm run audit:mobile` can still see it. */}
  <div
    id="app-scroll"
    data-scroll-root
    class="min-h-0 flex-1 overflow-y-auto overflow-x-hidden overscroll-y-contain"
  >
  <div class="flex min-h-full flex-col">
  <header
    id="app-header"
    class="pt-safe sticky top-0 z-50 border-b border-border bg-bg transition-transform duration-300 ease-[cubic-bezier(0.77,0,0.175,1)] pointer-fine:bg-bg/90 pointer-fine:backdrop-blur-md"
  >
    <div class="mx-auto flex h-12 max-w-3xl items-center justify-between px-4 sm:px-6">
      <div class="flex items-center gap-1">
        {/* Drawer opener — moved here from the bottom ribbon's old "More" slot
            so the ribbon can spend its five slots on destinations. Same
            id/aria wiring as before, so the drawer script below binds to it
            unchanged. Flat, not `.hill-btn`: icon-only chrome at this scale
            stays flat by design (see the button rules in CLAUDE.md). */}
        <button
          id="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="nav-menu"
          aria-label="Menu"
          class="flex min-h-11 min-w-11 items-center justify-center text-fg"
        >
          <span aria-hidden="true" class="flex flex-col items-center justify-center gap-[4px]">
            <span class="block h-[2px] w-5 bg-current"></span>
            <span class="block h-[2px] w-5 bg-current"></span>
            <span class="block h-[2px] w-5 bg-current"></span>
          </span>
        </button>
        <a
          href={home}
          class="flex min-h-11 items-center font-display text-base font-semibold uppercase tracking-tight text-fg"
        >
          Verocity
        </a>
      </div>
      {
        showcase && (
          <div class="flex items-center gap-3">
            <span class="hidden text-[0.6rem] uppercase tracking-[0.18em] text-muted sm:inline">
              Read-only showcase
            </span>
            <a
              href="/login"
              class="inline-flex h-9 items-center rounded-full border border-fg px-4 text-xs uppercase tracking-wider text-fg transition-colors duration-200 hover:bg-fg hover:text-bg"
            >
              Sign in
            </a>
          </div>
        )
      }
    </div>
  </header>

  <div id="nav-backdrop" class="fixed inset-0 z-[60] hidden"></div>

  <nav
    id="nav-menu"
    aria-label="Primary"
    class="fixed left-0 top-0 z-[70] flex h-dvh w-64 -translate-x-full flex-col border-r border-border bg-bg shadow-2xl transition-transform duration-300 ease-[cubic-bezier(0.77,0,0.175,1)] pointer-fine:bg-bg/90 pointer-fine:backdrop-blur-xl"
  >
    <div class="flex h-16 shrink-0 items-center px-6">
      <span class="font-display text-lg font-semibold uppercase tracking-tight text-fg">Verocity</span>
    </div>
    {/* Grouped, so it scrolls: ten 44px rows plus four eyebrows measure ~648px
        against 667px of dvh on a 375-wide phone, and this panel carries no
        pb-safe of its own — on a home-indicator device the last row would sit
        under the indicator with no way to reach it. `overscroll-contain` keeps
        a flick at either end from chaining to the page underneath. */}
    <div class="pb-safe min-h-0 flex-1 overflow-y-auto overscroll-contain px-3 py-2">
      {
        groups.map((g, i) => (
          <div class:list={[i > 0 && 'mt-2 border-t border-border pt-2']}>
            <div
              class:list={['t-eyebrow px-3 py-2', groupActive(g) ? 'text-fg' : 'text-muted']}
            >
              {g.label}
            </div>
            {g.items.map((l) => (
              <a
                href={l.href}
                data-nav-link
                aria-current={isActive(l.href) ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center gap-2 px-3 text-sm uppercase tracking-wider transition-colors duration-150 hover:text-fg',
                  isActive(l.href) ? 'text-fg' : 'text-muted',
                ]}
              >
                {/* The gutter is always present and always this wide, so the
                    marker appearing on the current row shifts nothing. It also
                    indents the items under their eyebrow. */}
                <span aria-hidden="true" class="flex w-3 shrink-0 items-center">
                  {isActive(l.href) && <span class="block h-[3px] w-[3px] bg-fg" />}
                </span>
                {l.svgGlyph && (
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 28"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-4 w-4 shrink-0"
                  >
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" transform="translate(-4 -1) rotate(-90 12 9)" />
                    <path d="M3 17h18a2 2 0 0 1 2 2v1a11 8 0 0 1-22 0v-1a2 2 0 0 1 2-2Z" />
                  </svg>
                )}
                {l.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
    {
      showcase && (
        <div class="shrink-0 border-t border-border px-6 py-4">
          <p class="text-[0.7rem] leading-relaxed text-muted">
            You're viewing a read-only demo profile. Nothing here can be edited.
          </p>
          <a
            href="/login"
            class="mt-3 inline-flex h-10 items-center rounded-full bg-fg px-5 text-xs uppercase tracking-wider text-bg transition-transform duration-200 hover:scale-[1.03]"
          >
            Start your own
          </a>
        </div>
      )
    }
  </nav>

  {/* A PLAIN BLOCK on every route but the Logger's, and that is load-bearing.
      Astro gives `<astro-island>` `display: contents`, so making `main` a flex
      container promotes each page's own root div to a direct flex item — and
      those roots carry `mx-auto`. A flex item with auto margins in the cross
      axis does not stretch: it takes `fit-content` instead, capped by its
      `max-w-3xl`. On a phone that laid the whole page out at 768px inside a
      393px viewport, pannable sideways. See docs/LESSONS.md § "The page lays
      out wider than the screen".
      `.main-immersive` opts the Logger in, because it needs `flex-1` to claim
      the scrollport so its Finish bar lands on the bottom edge — and its root
      has no auto margins, so it stretches. */}
  <main id="main" class:list={['flex-1', immersive && 'main-immersive flex flex-col']}>
    <slot />
  </main>
  </div>
  </div>

  {/* Thumb-reachable primary nav. The drawer above survives as "More" so the
      full destination list stays one tap away.

      NOT positioned at all — no `fixed`, and no `sticky` either. Both resolve
      `bottom: 0` against iOS Safari's LAYOUT viewport, which lags the visual
      one for the whole of a scroll-down while the address bar retracts, so
      both strand the bar mid-screen with content running on underneath and
      both snap home on the first scroll up. Sticky was tried and shipped and
      did not fix it; see docs/LESSONS.md § "The bottom bar detaches".

      Instead the shell above does not scroll, so this is simply the last flex
      child of a box whose bottom edge is the screen's bottom edge — there is
      no viewport offset left to resolve, and nothing to lag. `relative z-50`
      only so `.ledge`'s upward shadow paints over the scroller it sits under;
      no `inset-x-0`, the flex column already stretches it full width. */}
  <nav
    aria-label="Primary"
    class:list={[
      'pb-safe ledge relative z-50 shrink-0 border-t border-border bg-bg pointer-fine:bg-bg/95 pointer-fine:backdrop-blur-md',
      immersive && 'hidden',
    ]}
  >
    {/* `gap-1` keeps the full-width cells from butting together: each tab's
        highlight now paints the whole cell, so without it the Log slot's ink
        would touch an active neighbour's pillow and the two would merge. */}
    <div class="mx-auto flex max-w-3xl items-stretch justify-around gap-1 px-2">
      {
        tabs.map((t) =>
          /* The app-mode centre slot asks what you are logging instead of
             navigating, so it is the one island in this otherwise static bar.
             Showcase keeps a plain link: its centre slot is Plan, a real
             destination, and the showcase mounts no write surfaces. */
          t.action === 'log' ? (
            <LogTabButton label={t.label} glyph={t.glyph} client:load />
          ) : (
            <a
              href={t.href}
              data-group-tab={t.group}
              aria-current={tabActive(t) ? 'page' : undefined}
              class:list={[
                'flex min-h-13 flex-1 flex-col items-center justify-center gap-0.5 transition-colors duration-150',
                /* Primary beats active: the centre slot stays ink even when it
                   is also the current route (the showcase's Plan tab), and it
                   paints its own fg/bg pair, so no colour utility here. */
                t.primary
                  ? 'tab-bubble-primary'
                  : [tabActive(t) ? 'tab-bubble text-fg' : 'text-muted hover:text-fg'],
              ]}
            >
              {/* Fixed h-8 glyph row on every tab so baselines stay aligned and
                  nothing shifts vertically between pages. Icons share
                  viewBox="0 0 24 24", stroke-width 1.8 and currentColor so the
                  set reads as one, and so the primary (ink) slot's paper stroke
                  and the muted/active fg swaps come for free. */}
              <span aria-hidden="true" class="flex h-8 items-center justify-center text-[1.75rem] leading-none">
                {t.icon ? (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-7 w-7"
                  >
                    {t.icon === 'home' && (
                      <>
                        <path d="M12 3.5 L20 10.5 V19 A1.5 1.5 0 0 1 18.5 20.5 H5.5 A1.5 1.5 0 0 1 4 19 V10.5 Z" />
                        <path d="M9 17.5 H15" />
                      </>
                    )}
                    {t.icon === 'training' && (
                      <>
                        <path d="M5.5 4.5 A1.5 1.5 0 0 1 8.5 4.5 V7.6 C 8.5 8.4 9.4 8.9 10.8 9.2 C 15 10 18.6 10.6 20 13.2 C 20.8 14.7 20.4 16.7 18.8 17.6 C 16.8 18.8 13.4 18.9 10.4 17.9 C 7.4 16.9 5.5 14.6 5.5 11.6 Z" />
                        <path d="M14.5 15.5 H16.3" />
                      </>
                    )}
                    {t.icon === 'progress' && (
                      <>
                        <path d="M12 20.5 C 4 15 3 11 3 7.7 C 3 5.2 5 3.5 7.5 3.5 C 9.5 3.5 11 4.6 12 6 C 13 4.6 14.5 3.5 16.5 3.5 C 19 3.5 21 5.2 21 7.7 C 21 11 20 15 12 20.5 Z" />
                        <path d="M5.5 11 H8.3 L9.7 8.5 L12.2 13.5 L13.7 11 H18.5" />
                      </>
                    )}
                    {t.icon === 'log' && (
                      <>
                        <path d="M4 5.5 C 4 4.2 5 3.5 6 3.5 H12 C 13.1 3.5 14 4.5 14 5.8 V6.6 C 14 7.6 13.2 8.4 12.2 8.4 H5.5 C 4.6 8.4 4 7.8 4 7 Z" />
                        <path d="M5.5 8.4 V17.2 C 5.5 18.7 4.5 19.7 3 19.7" />
                        <path d="M3 19.7 H10.5 C 12 19.7 13 18.7 13 17.2 V16.4 H5.5" />
                        <path d="M7 12.4 Q 8.5 11.6 10 12.4 T 12 12.4" />
                        <path d="M20.5 3.8 L15 9.2" />
                        <path d="M15 9.2 Q 13.6 6.6 15.8 5.2 Q 18 4.4 19.8 4.6" />
                      </>
                    )}
                  </svg>
                ) : t.svgGlyph ? (
                  <svg
                    viewBox="0 0 24 28"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-7 w-7"
                  >
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" transform="translate(-4 -1) rotate(-90 12 9)" />
                    <path d="M3 17h18a2 2 0 0 1 2 2v1a11 8 0 0 1-22 0v-1a2 2 0 0 1 2-2Z" />
                  </svg>
                ) : t.glyph}
              </span>
              <span class="t-control">{t.label}</span>
            </a>
          ),
        )
      }
    </div>
  </nav>
  </div>
</Base>

<script>
  // ClientRouter swaps the DOM between pages, so handlers must rebind on every
  // astro:page-load — otherwise the burger goes dead after the first navigation.
  let ac: AbortController | null = null;

  // The scroll position lives on #app-scroll now rather than the window, so
  // ClientRouter's own restoration (which calls window.scrollTo) no longer
  // reaches it and every back navigation would land at the top. Stash the
  // outgoing position on the way out and put it back on a traversal — document
  // listeners survive the swap, so this binds once.
  const SCROLL_KEY = 'verocity:scroll';
  let restoreTo = 0;

  function readScrollStore(): Record<string, number> {
    try {
      const raw = sessionStorage.getItem(SCROLL_KEY);
      return raw ? (JSON.parse(raw) as Record<string, number>) : {};
    } catch {
      return {};
    }
  }

  document.addEventListener('astro:before-preparation', (event) => {
    const e = event as unknown as { from: URL; to: URL; direction: string };
    const store = readScrollStore();
    const el = document.getElementById('app-scroll');
    // `e.from`, NOT `location`: on a back/forward traversal the browser has
    // already moved `location` to the destination by the time this fires, so
    // keying on it filed the OUTGOING position under the INCOMING path —
    // overwriting the very entry the restore below then read back as 0.
    if (el) store[e.from.pathname] = el.scrollTop;
    try {
      sessionStorage.setItem(SCROLL_KEY, JSON.stringify(store));
    } catch {
      /* private mode / quota — the restore just no-ops */
    }
    restoreTo = e.direction === 'back' ? (store[e.to.pathname] ?? 0) : 0;
  });

  function setupNav() {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;

    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('nav-menu');
    const backdrop = document.getElementById('nav-backdrop');
    if (!toggle || !menu || !backdrop) return;

    let open = false;
    const setOpen = (next: boolean) => {
      open = next;
      toggle.setAttribute('aria-expanded', String(next));
      menu.classList.toggle('-translate-x-full', !next);
      backdrop.classList.toggle('hidden', !next);
    };

    toggle.addEventListener(
      'click',
      (e) => {
        e.stopPropagation();
        setOpen(!open);
      },
      { signal },
    );
    backdrop.addEventListener('click', () => setOpen(false), { signal });
    menu.querySelectorAll('[data-nav-link]').forEach((link) =>
      link.addEventListener('click', () => setOpen(false), { signal }),
    );
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape') setOpen(false);
      },
      { signal },
    );

    // Training/Progress ribbon tabs reopen whichever sub-page you last viewed
    // in that group, written by GroupPager.tsx on every in-group tab change.
    // Key prefix must match src/lib/appNav.ts's navStorageKey().
    document.querySelectorAll<HTMLAnchorElement>('[data-group-tab]').forEach((a) => {
      const key = a.dataset.groupTab;
      if (!key) return;
      try {
        const stored = sessionStorage.getItem(`verocity:nav:${key}`);
        if (stored) a.href = stored;
      } catch {
        /* private mode / quota — falls back to the group's base page */
      }
    });

    // The shell took scrolling away from the document, so everything below
    // reads #app-scroll rather than the window.
    const scroller = document.getElementById('app-scroll');
    if (!scroller) return;

    if (restoreTo) {
      // Re-applied rather than assigned once: every page's content arrives with
      // its island, which is after astro:page-load, so at this point the
      // scroller is usually still one viewport tall and a single assignment
      // clamps to 0. Give up the moment it takes, the moment the user reaches
      // for the page, or after 1.2s — whichever comes first.
      const target = restoreTo;
      const deadline = performance.now() + 1200;
      let cancelled = false;
      const cancel = () => {
        cancelled = true;
      };
      for (const ev of ['wheel', 'touchstart', 'pointerdown'] as const) {
        scroller.addEventListener(ev, cancel, { once: true, passive: true, signal });
      }
      const settle = () => {
        if (cancelled || signal.aborted) return;
        scroller.scrollTop = target;
        if (Math.abs(scroller.scrollTop - target) > 1 && performance.now() < deadline) {
          requestAnimationFrame(settle);
        }
      };
      settle();
    }
    restoreTo = 0;

    // Reclaim the header's 48px while the user is reading down the page, and
    // hand it back the moment they scroll up. Skipped under reduced-motion,
    // where a header that moves on its own is the thing being opted out of.
    const header = document.getElementById('app-header');
    if (!header || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Hysteresis, and track the state rather than re-deriving it per frame.
    // The naive version compared against the previous frame with a 4px
    // deadzone, which momentum scrolling walks straight through: measured 18
    // class flips in a single one-second scroll, each starting a 300ms
    // transform transition. That churn is a repaint on every page.
    //
    // Now the header only moves after 24px of committed travel in one
    // direction, and only when that would actually change its state.
    const TRAVEL = 24;
    let lastY = scroller.scrollTop;
    let hidden = false;
    let travel = 0;
    let ticking = false;

    const setHidden = (next: boolean) => {
      if (next === hidden) return;
      hidden = next;
      header.classList.toggle('-translate-y-full', next);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const y = Math.max(0, scroller.scrollTop);
        const dy = y - lastY;
        lastY = y;
        if (dy === 0) return;
        // Near the top the header is always shown, whatever the direction.
        if (y <= 96) {
          travel = 0;
          setHidden(false);
          return;
        }
        // A direction change restarts the count, so a wobble never accumulates.
        if (dy > 0 !== travel > 0) travel = 0;
        travel += dy;
        if (travel > TRAVEL) {
          setHidden(true);
          travel = 0;
        } else if (travel < -TRAVEL) {
          setHidden(false);
          travel = 0;
        }
      });
    };
    scroller.addEventListener('scroll', onScroll, { passive: true, signal });
  }

  document.addEventListener('astro:page-load', setupNav);
</script>
