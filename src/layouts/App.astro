---
import Base from './Base.astro';

interface Props {
  title?: string;
  // Read-only public showcase: swaps the nav to the /showcase/* surfaces (which
  // mount no write affordances) and shows a "sign in" CTA instead of app tools.
  showcase?: boolean;
}

const { title = 'Verocity', showcase = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const home = showcase ? '/showcase' : '/app';
const links = showcase
  ? [
      { href: '/showcase', label: 'Home' },
      { href: '/showcase/calendar', label: 'Calendar' },
      { href: '/showcase/stats', label: 'Stats' },
      { href: '/showcase/plan', label: 'Plan' },
      { href: '/showcase/library', label: 'Library' },
    ]
  : [
      { href: '/app', label: 'Home' },
      { href: '/app/calendar', label: 'Calendar' },
      { href: '/app/stats', label: 'Stats' },
      { href: '/app/coach', label: 'Coach' },
      { href: '/app/plan', label: 'Plan' },
      { href: '/app/sessions', label: 'Sessions' },
      { href: '/app/library', label: 'Library' },
    ];
const isActive = (href: string) => (href === home ? path === home : path.startsWith(href));

// The Logger owns the bottom of the screen — it has its own Finish bar, and
// stacking a tab bar under it would put two fixed bars in the thumb zone. It
// is a focused flow you leave deliberately (Finish / Discard), so the tabs sit
// this one out.
const immersive = path === '/app/log';

// The four destinations that earn a permanent thumb-reachable slot, plus the
// centre action. Everything else stays one tap away behind "More" (the drawer),
// so no destination is lost. Showcase has no write surface, so its centre slot
// is Plan rather than Log.
const tabs = showcase
  ? [
      { href: '/showcase', label: 'Home', glyph: '◫' },
      { href: '/showcase/calendar', label: 'Calendar', glyph: '▤' },
      { href: '/showcase/plan', label: 'Plan', glyph: '◈', primary: true },
      { href: '/showcase/stats', label: 'Stats', glyph: '◲' },
    ]
  : [
      { href: '/app', label: 'Home', glyph: '◫' },
      { href: '/app/calendar', label: 'Calendar', glyph: '▤' },
      { href: '/app/log', label: 'Log', glyph: '+', primary: true },
      { href: '/app/stats', label: 'Stats', glyph: '◲' },
    ];

// Settings, Sessions, Library, Coach, Plan, Shares and the detail pages are all
// reached through "More", so none of the four tabs matches them and the bar
// would show no current page at all. "More" stands in as the active tab there.
const onTab = tabs.some((t) => isActive(t.href));
---

<Base title={title}>
  <a href="#main" class="skip-link">Skip to content</a>
  <header
    id="app-header"
    class="pt-safe sticky top-0 z-50 border-b border-border bg-bg transition-transform duration-300 ease-[cubic-bezier(0.77,0,0.175,1)] pointer-fine:bg-bg/90 pointer-fine:backdrop-blur-md"
  >
    <div class="mx-auto flex h-12 max-w-3xl items-center justify-between px-4 sm:px-6">
      <a
        href={home}
        class="flex min-h-11 items-center font-display text-base font-semibold uppercase tracking-tight text-fg"
      >
        Verocity
      </a>
      {
        showcase && (
          <div class="flex items-center gap-3">
            <span class="hidden text-[0.6rem] uppercase tracking-[0.18em] text-muted sm:inline">
              Read-only showcase
            </span>
            <a
              href="/login"
              class="inline-flex h-9 items-center rounded-full border border-fg px-4 text-xs uppercase tracking-wider text-fg transition-colors duration-200 hover:bg-fg hover:text-bg"
            >
              Sign in
            </a>
          </div>
        )
      }
    </div>
  </header>

  <div id="nav-backdrop" class="fixed inset-0 z-[60] hidden"></div>

  <nav
    id="nav-menu"
    aria-label="Primary"
    class="fixed left-0 top-0 z-[70] h-dvh w-64 -translate-x-full border-r border-border bg-bg shadow-2xl transition-transform duration-300 ease-[cubic-bezier(0.77,0,0.175,1)] pointer-fine:bg-bg/90 pointer-fine:backdrop-blur-xl"
  >
    <div class="flex h-16 items-center px-6">
      <span class="font-display text-lg font-semibold uppercase tracking-tight text-fg">Verocity</span>
    </div>
    <div class="px-3 py-2">
      {
        links.map((l) => (
          <a
            href={l.href}
            data-nav-link
            aria-current={isActive(l.href) ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center px-3 text-sm uppercase tracking-wider transition-colors duration-150 hover:text-fg',
              isActive(l.href) ? 'text-fg' : 'text-muted',
            ]}
          >
            {l.label}
          </a>
        ))
      }
      {
        !showcase && (
          <>
            <div class="my-2 border-t border-border" />
            <a
              href="/app/settings"
              data-nav-link
              aria-current={isActive('/app/settings') ? 'page' : undefined}
              class:list={[
                'flex min-h-11 items-center px-3 text-sm uppercase tracking-wider transition-colors duration-150 hover:text-fg',
                isActive('/app/settings') ? 'text-fg' : 'text-muted',
              ]}
            >
              Settings
            </a>
          </>
        )
      }
    </div>
    {
      showcase && (
        <div class="mt-2 border-t border-border px-6 py-4">
          <p class="text-[0.7rem] leading-relaxed text-muted">
            You're viewing a read-only demo profile. Nothing here can be edited.
          </p>
          <a
            href="/login"
            class="mt-3 inline-flex h-10 items-center rounded-full bg-fg px-5 text-xs uppercase tracking-wider text-bg transition-transform duration-200 hover:scale-[1.03]"
          >
            Start your own
          </a>
        </div>
      )
    }
  </nav>

  <main id="main" class={immersive ? '' : 'pb-[calc(4.5rem+env(safe-area-inset-bottom))]'}>
    <slot />
  </main>

  {/* Thumb-reachable primary nav. The drawer above survives as "More" so the
      full destination list stays one tap away. */}
  <nav
    aria-label="Primary"
    class:list={[
      'pb-safe fixed inset-x-0 bottom-0 z-50 border-t border-border bg-bg pointer-fine:bg-bg/95 pointer-fine:backdrop-blur-md',
      immersive && 'hidden',
    ]}
  >
    <div class="mx-auto flex max-w-3xl items-stretch justify-around px-2">
      {
        tabs.map((t) => (
          <a
            href={t.href}
            aria-current={isActive(t.href) ? 'page' : undefined}
            class:list={[
              'flex min-h-14 flex-1 flex-col items-center justify-center gap-1 transition-colors duration-150',
              isActive(t.href) ? 'text-fg' : 'text-muted hover:text-fg',
            ]}
          >
            <span
              aria-hidden="true"
              class:list={[
                'flex h-6 w-6 items-center justify-center text-base leading-none',
                t.primary ? 'border border-fg bg-fg text-bg' : '',
              ]}
            >
              {t.glyph}
            </span>
            <span class="t-control">{t.label}</span>
          </a>
        ))
      }
      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-current={onTab ? undefined : 'page'}
        class:list={[
          'flex min-h-14 flex-1 flex-col items-center justify-center gap-1 transition-colors duration-150',
          onTab ? 'text-muted hover:text-fg' : 'text-fg',
        ]}
      >
        <span class="flex h-6 w-6 flex-col items-center justify-center gap-[3px]" aria-hidden="true">
          <span class="block h-[2px] w-4 bg-current"></span>
          <span class="block h-[2px] w-4 bg-current"></span>
          <span class="block h-[2px] w-4 bg-current"></span>
        </span>
        <span class="t-control">More</span>
      </button>
    </div>
  </nav>
</Base>

<script>
  // ClientRouter swaps the DOM between pages, so handlers must rebind on every
  // astro:page-load — otherwise the burger goes dead after the first navigation.
  let ac: AbortController | null = null;

  function setupNav() {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;

    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('nav-menu');
    const backdrop = document.getElementById('nav-backdrop');
    if (!toggle || !menu || !backdrop) return;

    let open = false;
    const setOpen = (next: boolean) => {
      open = next;
      toggle.setAttribute('aria-expanded', String(next));
      menu.classList.toggle('-translate-x-full', !next);
      backdrop.classList.toggle('hidden', !next);
    };

    toggle.addEventListener(
      'click',
      (e) => {
        e.stopPropagation();
        setOpen(!open);
      },
      { signal },
    );
    backdrop.addEventListener('click', () => setOpen(false), { signal });
    menu.querySelectorAll('[data-nav-link]').forEach((link) =>
      link.addEventListener('click', () => setOpen(false), { signal }),
    );
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape') setOpen(false);
      },
      { signal },
    );

    // Reclaim the header's 48px while the user is reading down the page, and
    // hand it back the moment they scroll up. Skipped under reduced-motion,
    // where a header that moves on its own is the thing being opted out of.
    const header = document.getElementById('app-header');
    if (!header || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Hysteresis, and track the state rather than re-deriving it per frame.
    // The naive version compared against the previous frame with a 4px
    // deadzone, which momentum scrolling walks straight through: measured 18
    // class flips in a single one-second scroll, each starting a 300ms
    // transform transition. That churn is a repaint on every page.
    //
    // Now the header only moves after 24px of committed travel in one
    // direction, and only when that would actually change its state.
    const TRAVEL = 24;
    let lastY = window.scrollY;
    let hidden = false;
    let travel = 0;
    let ticking = false;

    const setHidden = (next: boolean) => {
      if (next === hidden) return;
      hidden = next;
      header.classList.toggle('-translate-y-full', next);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const y = Math.max(0, window.scrollY);
        const dy = y - lastY;
        lastY = y;
        if (dy === 0) return;
        // Near the top the header is always shown, whatever the direction.
        if (y <= 96) {
          travel = 0;
          setHidden(false);
          return;
        }
        // A direction change restarts the count, so a wobble never accumulates.
        if (dy > 0 !== travel > 0) travel = 0;
        travel += dy;
        if (travel > TRAVEL) {
          setHidden(true);
          travel = 0;
        } else if (travel < -TRAVEL) {
          setHidden(false);
          travel = 0;
        }
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true, signal });
  }

  document.addEventListener('astro:page-load', setupNav);
</script>
